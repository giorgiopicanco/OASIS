include README.md
include LICENSE
include CITATION.cff
include requirements.txt
recursive-include pyOASIS *.py
recursive-include tests *.py
recursive-include examples *.py
include docs/*.md

prune references
prune INPUT
prune OUTPUT

global-exclude *.pyc
global-exclude *.pyo
global-exclude *.bak

include main.py main_sequential.py main_rbmc_rinex2.py run_oasis_grec.py
include THIRD_PARTY_NOTICES.md
recursive-include img *.png
